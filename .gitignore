# Rules without a leading slash apply throughout this monorepo.
# Keep source, migrations, dependency manifests/lockfiles, assets, and docs tracked.

# Python bytecode, test/type/lint caches, and coverage
__pycache__/
*.pyc
*.pyo
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Python virtual environments
venv/
.venv/
env/
.env/
ENV/

# Environment files and local secrets (templates are allowed below)
.env
.env.*
*.env
.envrc.local
.secrets/
secrets.local
secrets.local.*
*.secret
*.secrets
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
credentials.local
credentials.local.*
api-keys.json
api_keys.json
apikeys.json
api_key.txt
api_keys.txt
api-keys.txt
service-account*.json
service_account*.json
.aws/
.ssh/
.netrc
.pypirc
*.key
*.pem
*.p12
*.pfx
id_rsa
id_dsa
id_ecdsa
id_ed25519
!.env.example
!.env.sample
!.env.*.example
!.env.*.sample
!*.env.example
!*.env.sample

# React, Vite, Next.js, Node dependencies, and package-manager caches
node_modules/
dist/
build/
.vite/
.next/
.npm/
.pnpm-store/
coverage/
*.tsbuildinfo

# Runtime SQLite databases and journal/WAL/SHM sidecars
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Logs, temporary files, and editor backups
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor-local files; retain shareable VS Code project configuration
.idea/
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/*.code-snippets

# Python package artifacts and tool caches
*.egg-info/
.eggs/
*.egg
*.whl
.cache/
**/graphify-out/cache/

# Local runtime outputs only: do not ignore PDFs/images or generic assets globally.
**/uploads/*
**/user-uploads/*
**/cached-images/*
**/image-cache/*
**/generated-pdfs/*
**/runtime/*
**/runtime-data/*
**/runtime-storage/*
**/local-storage/*
.runtime/
.local-data/
**/storage/uploads/*
**/storage/cache/*
**/storage/runtime/*
**/storage/generated/*
# Retain directory placeholders and documentation for runtime folders.
!**/.gitkeep
!**/.gitignore
!**/README
!**/README.md
!**/README.rst
